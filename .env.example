APCA_API_KEY_ID=your_alpaca_paper_key
APCA_API_SECRET_KEY=your_alpaca_paper_secret
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_API_DATA_URL=https://data.alpaca.markets

# Optional: Mentor TradingView eyes-on equity fallback after Alpaca bars.
# Default source order for equities is Alpaca -> Tradier -> yfinance.
TRADIER_ACCESS_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1

VELEZ_WEBHOOK_SECRET=replace-with-a-long-random-token
VELEZ_APPROVAL_API_TOKEN=replace-with-a-separate-local-approval-token

# Leave false unless you intentionally arm paper order submission.
# Hard override: blocks entries, approvals, cancellations, exits, and protective-order mutations.
# Keep true for observation-only deployments. VELEZ_WATCH_ONLY takes precedence over legacy WATCH_ONLY.
VELEZ_WATCH_ONLY=true
VELEZ_EXECUTE_ORDERS=false
VELEZ_DATA_DIR=bot/data/runtime
VELEZ_AUTO_STAGE_PROPOSED_ORDERS=false
VELEZ_REQUIRE_ORDER_APPROVAL=true
VELEZ_APPROVAL_TTL_MINUTES=30
VELEZ_LIFECYCLE_AUTO_EXECUTE=false
VELEZ_LIFECYCLE_AUTO_CLOSE_OVER_LIMIT=false
VELEZ_LIFECYCLE_UNPROTECTED_DEADLINE_ENABLED=true
VELEZ_LIFECYCLE_UNPROTECTED_DEADLINE_SECONDS=120

# Keep Bullwarden enabled and fail-closed. Supply the API key out of band.
BULLWARDEN_ENABLED=true
BULLWARDEN_FAIL_CLOSED=true
BULLWARDEN_URL=http://bull-warden:8080
BULLWARDEN_API_KEY=replace-with-the-bullwarden-api-key

# Optional: powers the calendar panel with month P/L, earnings, macro events,
# market sessions, and the session journal.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
CALENDAR_FEED_TIMEOUT_SECONDS=8
CALENDAR_FEED_CACHE_SECONDS=21600
CALENDAR_EVENT_LOOKAHEAD_DAYS=45
CALENDAR_MACRO_FEEDS_ENABLED=true
BLS_CALENDAR_ICS_URL=https://www.bls.gov/schedule/news_release/bls.ics
BEA_CALENDAR_URL=https://www.bea.gov/news/schedule/full
CENSUS_CALENDAR_URL=https://www.census.gov/economic-indicators/calendar-listview.html
NYFED_CALENDAR_URL=https://www.newyorkfed.org/research/national_economy/nationalecon_cal.html
FOMC_CALENDAR_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm

# Optional: Winston Research Mode can reuse Winston's normal LLM or point at a
# slower/deeper model.
WINSTON_RESEARCH_LLM_PROVIDER=ollama
WINSTON_RESEARCH_LLM_BASE_URL=http://127.0.0.1:11434
WINSTON_RESEARCH_LLM_MODEL=qwen3.5:2b
WINSTON_RESEARCH_THINK=false
WINSTON_RESEARCH_MAX_TOKENS=700
WINSTON_RESEARCH_TIMEOUT_SECONDS=90

# Optional: enables the desk iPod MusicKit connection.
APPLE_MUSIC_TEAM_ID=your-10-character-team-id
APPLE_MUSIC_KEY_ID=your-media-services-key-id
APPLE_MUSIC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8
APPLE_MUSIC_TOKEN_TTL_HOURS=12
APPLE_MUSIC_TOKEN_ORIGINS=https://your-bot-domain.example
